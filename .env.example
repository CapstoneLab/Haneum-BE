APP_ENV=production
LOG_LEVEL=INFO

# Use long, independently generated values in production.
ANDROID_API_KEY=replace-with-a-random-value-at-least-32-characters
INTERNAL_API_KEY=replace-with-a-different-random-value-at-least-32-characters

POSTGRES_DB=keyback
POSTGRES_USER=keyback
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

LLM_PROVIDER=claude
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-6

# Only used when LLM_PROVIDER=local.
LLM_BASE_URL=http://host.docker.internal:8001/internal/v1
LLM_TIMEOUT_SECONDS=8
